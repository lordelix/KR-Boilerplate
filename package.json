{
	"name": "boilerplate.ts",
	"version": "5.4.0-11",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate-api-specs": "npx openapi-typescript https://api.klickrhein.de/v6/openapi.yaml -o ./src/lib/boilerplate/xioni/api/api.d.ts --make-paths-enum --root-types",
		"postinstall": "npm run generate-api-specs",
		"update": "npx npm-check-updates",
		"version:prerelease": "npm version prerelease --no-git-tag-version",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.49.2",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@types/eslint": "9.6.1",
		"@types/node": "25.0.2",
		"@typescript-eslint/eslint-plugin": "8.49.0",
		"@typescript-eslint/parser": "8.49.0",
		"eslint": "9.39.2",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.13.1",
		"openapi-typescript": "7.10.1",
		"prettier": "3.7.4",
		"prettier-plugin-svelte": "3.4.1",
		"sass": "1.96.0",
		"svelte-check": "4.3.4",
		"sveltekit-autoimport": "1.8.2",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vite": "7.3.0"
	},
	"type": "module",
	"dependencies": {
		"@glidejs/glide": "3.7.1",
		"@types/glidejs__glide": "3.6.6",
		"@types/lodash-es": "4.17.12",
		"date-fns": "4.1.0",
		"lodash-es": "4.17.21",
		"openapi-fetch": "0.15.0",
		"openapi-typescript-fetch": "2.2.1",
		"opening_hours": "3.9.0",
		"svelte": "5.46.0",
		"svelte-preprocess": "6.0.3"
	}
}
