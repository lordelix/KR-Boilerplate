{
	"name": "boilerplate.ts",
	"version": "5.4.0-4",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"generate-api-specs": "npx openapi-typescript https://api.klickrhein.de/v6/openapi.yaml -o ./src/lib/boilerplate/xioni/api/api.d.ts --make-paths-enum --root-types",
		"postinstall": "npm run generate-api-specs",
		"update": "npx npm-check-updates",
		"version:prerelease": "npm version prerelease --no-git-tag-version",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.47.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/eslint": "^9.6.1",
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"@typescript-eslint/parser": "^8.46.2",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.5",
		"openapi-typescript": "^7.10.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"sass": "^1.93.2",
		"svelte-check": "^4.3.3",
		"sveltekit-autoimport": "^1.8.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.1.12"
	},
	"type": "module",
	"dependencies": {
		"@glidejs/glide": "^3.7.1",
		"@types/glidejs__glide": "^3.6.6",
		"@types/lodash-es": "^4.17.12",
		"date-fns": "^4.1.0",
		"lodash-es": "^4.17.21",
		"openapi-fetch": "^0.15.0",
		"openapi-typescript-fetch": "^2.2.1",
		"opening_hours": "^3.9.0",
		"svelte": "^5.41.3",
		"svelte-preprocess": "^6.0.3"
	}
}
